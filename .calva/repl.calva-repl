(defn main []
  (f/run
   (m/MaterialApp
    .home
    (m/Scaffold
     .appBar (m/AppBar .title (m/Text "Onitama Lab"))
     .body
     (f/widget
      :with [state (f/atom 0) ;; Створюємо локальний "атом" (стан)
             (m/Center
              .child
              (m/Column ;; Колонка, щоб покласти текст НАД кнопкою
               .mainAxisAlignment m.MainAxisAlignment/center
               .children
               [(m/Text (str "Кліків: " @state)
                        .style (m/TextStyle .fontSize 24.0))

                (m/SizedBox .height 20.0) ;; Просто відступ

                (m/ElevatedButton
                 .onPressed (fn [] (swap! state inc)) ;; ФУНКЦІЯ!
                 .child (m/Text "Натисни мене!"))]))])))))
