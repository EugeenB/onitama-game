(defn handle-tile-press [server-path selected-card  move-to-tiles [x y]]
  (let [url (dc/Uri.parse (str server-path "/moves?card=" @selected-card "&x=" x "&y=" y))]
    (println "query: " url)
    (reset! selected-tile [x y])
    (-> (http/get url)
        (.then (fn [^http/Response res] ;; тип ^http/Response
                 (reset! move-to-tiles (.-body res))
                 (println "server response " @move-to-tiles)))
        (.catchError (fn [e]
                       (println "network error" e))))
    nil))
